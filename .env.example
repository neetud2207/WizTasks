# PostgreSQL connection string
# Example (local): postgresql://postgres:postgres@localhost:5432/hogwarts_task_ledger?schema=public
# Example (hosted, e.g. Neon/Supabase/RDS): postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Node environment
NODE_ENV=development
